# =============================================================================
#             WFSEEK SYSTEM WIDE CONFIGURATION AND SECRETS
# =============================================================================
# Copy this file to a ".env" file locally, or configure these variables as
# Environment Variables in Vercel / GitHub Secrets / Server Host.

# -----------------------------------------------------------------------------
# 1. AI STUDIO / GEMINI SERVICES
# -----------------------------------------------------------------------------
# Required for running the intelligent bot actions inside the Android application.
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# 2. TELEGRAM ADMINISTRATION BOT SECRETS
# -----------------------------------------------------------------------------
# Token of your Telegram Administrator Bot (from @BotFather).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Whitelist of Telegram Chat IDs allowed to run /weekly, /monthly, /family, /expire, /list.
# Locate your Chat ID by texting @userinfobot. Multiple IDs can be comma-separated.
ADMIN_CHAT_ID=your_telegram_chat_id_here

# -----------------------------------------------------------------------------
# 3. FIREBASE INTEGRATION DETAILS
# -----------------------------------------------------------------------------
# The Unique Project ID of your Firebase Database project (e.g., wfdmike).
FIREBASE_PROJECT_ID=wfdmike

# -----------------------------------------------------------------------------
# 4. ANDROID APK SIGNING (GITHUB ACTIONS SECRETS)
# -----------------------------------------------------------------------------
# Keystores are stored securely as Base64 encoded strings in your GitHub Secrets.
# The Base64 encoded string of your real 'my-upload-key.jks' certificate:
KEYSTORE_BASE64=your_base64_keystore_string_here

# Passwords matching your Keystore Certificate:
STORE_PASSWORD=android
KEY_PASSWORD=android
